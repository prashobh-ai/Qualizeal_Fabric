# QualiZeal Knowledge Fabric — example environment (F0.3).
# Copy to `.env` and fill in only what you use. Never commit secrets.
# GitHub Actions gets ANTHROPIC_API_KEY as a repository secret for
# build-time answer recording (F8.3).

# --- Profile ----------------------------------------------------------------
# lite (default: stdlib only, no installs) or full (Postgres+pgvector,
# OTel collector, real engines). See docs/progress/P0.2.md.
KF_PROFILE=lite

# --- Model providers --------------------------------------------------------
# Provider order for escalation is [anthropic, openai, bedrock, vllm].
# KF_MODEL_MODE selects which provider is active this run; default is
# `anthropic` when ANTHROPIC_API_KEY is set, else `mock`.
KF_MODEL_MODE=anthropic

# Anthropic (first-class provider). API key from the Anthropic Console —
# note that this is an API key with credits, separate from a Claude.ai
# subscription. https://console.anthropic.com/
ANTHROPIC_API_KEY=
# Optional overrides for the endpoint (proxy/test) and version.
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_VERSION=2023-06-01

# OpenAI (empty placeholder until the company key arrives).
OPENAI_API_KEY=
# The existing OpenAI-compatible client reads:
# KF_MODEL_BASE_URL, KF_MODEL_API_KEY, KF_MODEL_NAME

# Bedrock (configured but inactive until cloud access arrives).
AWS_REGION=eu-west-1
BEDROCK_SMALL_MODEL=anthropic.claude-haiku-4-5
BEDROCK_LARGE_MODEL=anthropic.claude-opus-5

# vLLM (OpenAI-compatible, self-hosted). Base URL only when in use.
VLLM_BASE_URL=

# Per-tier model ids used by every provider. Defaults track the current
# Anthropic model set; the doctor validates them against the provider's
# model-list endpoint before a demo.
KF_MODEL_SMALL=claude-haiku-4-5
KF_MODEL_LARGE=claude-opus-5

# --- Answer path ------------------------------------------------------------
KF_GROUNDING_THRESHOLD=0.50
KF_CONFIDENCE_GATE=0.52
KF_EVIDENCE_BUDGET_L2=1500
KF_EVIDENCE_BUDGET_L3=6000
KF_SESSION_BLOCK_MAX_TOKENS=160

# --- Telemetry --------------------------------------------------------------
KF_TELEMETRY=sql
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=knowledge-fabric

# --- Identity ---------------------------------------------------------------
KF_IDENTITY=local
KF_IDP_SECRET=local-dev-secret-change-me

# --- Speech (F6) ------------------------------------------------------------
KF_SPEECH_ASR=faster-whisper
KF_SPEECH_TTS=kokoro
KF_SPEECH_RETAIN_AUDIO=false

# --- Connectors (empty until credentials arrive) ----------------------------
# SHAREPOINT_TENANT_ID=
# SHAREPOINT_CLIENT_ID=
# SHAREPOINT_CLIENT_SECRET=
# CONFLUENCE_URL=
# CONFLUENCE_API_TOKEN=
# JIRA_URL=
# JIRA_API_TOKEN=
# GITHUB_TOKEN=
# GDRIVE_SERVICE_ACCOUNT=
