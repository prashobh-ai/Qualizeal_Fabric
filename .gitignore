*.py[cod]
# runtime fabric data is ignored, but the source-of-truth config the preflight
# reads (T124) is tracked — a parent dir ignored as `data/` can't re-include a
# file, so ignore data/ contents with `data/*` and un-ignore that one file.
data/*
!data/showcase_sources.json
*.db
*.db-wal
*.db-shm
.env
.DS_Store
dist/

# T46: the fabric-data checkout lives on its own branch, never in main
fabric-data/

# background agent worktrees (harness working copies, never project files)
.claude/worktrees/
